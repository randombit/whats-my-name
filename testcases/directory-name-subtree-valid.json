    {
      "id": "dir-ca",
      "ca": true,
      "issuer": "root",
      "subject": "C=US,O=NC Tests,CN=Directory Constrained CA",
      "name_constraints": {
        "permitted": {
          "directory_name": [
            "C=US,O=Example Corp"
          ]
        }
      }
    },
    {
      "id": "leaf",
      "issuer": "dir-ca",
      "subject": "C=US,O=Example Corp,CN=Alice"
    }
  ]
