{
  "name": "multi-ca-permit-and-exclude-overlap-invalid",
  "expected": "invalid",
  "description": "Root permits .example.com; intermediate excludes .evil.example.com. A leaf SAN inside the excluded subtree must be rejected even though the parent permit covers it.",
  "references": [
    "RFC 5280 6.1.4(g)",
    "RFC 5280 6.1.4(h)",
    "RFC 5280 4.2.1.10"
  ],
  "certs": [
    {
      "id": "root",
      "ca": true,
      "self_signed": true,
      "subject": "C=US,O=NC Tests,CN=NC Test Root"
    },
    {
      "id": "permit-ca",
      "ca": true,
      "issuer": "root",
      "subject": "C=US,O=NC Tests,CN=Outer Permit CA",
      "name_constraints": {
        "permitted": {
          "dns": [
            ".example.com"
          ]
        }
      }
    },
    {
      "id": "exclude-ca",
      "ca": true,
      "issuer": "permit-ca",
      "subject": "C=US,O=NC Tests,CN=Inner Exclude CA",
      "name_constraints": {
        "excluded": {
          "dns": [
            ".evil.example.com"
          ]
        }
      }
    },
    {
      "id": "leaf",
      "issuer": "exclude-ca",
      "subject": "",
      "san": {
        "dns": [
          "host.evil.example.com"
        ]
      }
    }
  ]
}
