{
  "name": "directory-name-rdn-order-mismatch-invalid",
  "expected": "invalid",
  "description": "permittedSubtrees directoryName C=US,O=Example Corp does not match a leaf whose RDNs are the same attributes in a different order (O=Example Corp,C=US). The subtree match is order-sensitive.",
  "references": [
    "RFC 5280 4.2.1.10",
    "RFC 5280 7.1"
  ],
  "certs": [
    {
      "id": "root",
      "ca": true,
      "self_signed": true,
      "subject": "C=US,O=NC Tests,CN=NC Test Root"
    },
    {
      "id": "dir-ca",
      "ca": true,
      "issuer": "root",
      "subject": "C=US,O=NC Tests,CN=DN RDN-Order Permit CA",
      "name_constraints": {
        "permitted": {
          "directory_name": [
            "C=US,O=Example Corp"
          ]
        }
      }
    },
    {
      "id": "leaf",
      "issuer": "dir-ca",
      "subject": "O=Example Corp,C=US,CN=Alice"
    }
  ]
}
