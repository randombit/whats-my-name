{
  "name": "issuer-alt-name-outside-dns-permit-valid",
  "expected": "valid-rfc5280",
  "description": "Issuer alternative names are not used in name chaining and name constraints are not enforced against them. A leaf DNS SAN inside the permitted subtree remains valid even when the leaf also carries an issuerAltName DNS value outside that subtree.",
  "references": [
    "RFC 5280 4.2.1.7",
    "RFC 5280 4.2.1.10"
  ],
  "certs": [
    {
      "id": "root",
      "ca": true,
      "self_signed": true,
      "subject": "C=US,O=NC Tests,CN=NC Test Root"
    },
    {
      "id": "dns-ca",
      "ca": true,
      "issuer": "root",
      "subject": "C=US,O=NC Tests,CN=IssuerAltName Not Constrained CA",
      "name_constraints": {
        "permitted": {
          "dns": [
            "example.com"
          ]
        }
      }
    },
    {
      "id": "leaf",
      "issuer": "dns-ca",
      "subject": "C=US,O=NC Tests,CN=IssuerAltName Leaf",
      "san": {
        "dns": [
          "www.example.com"
        ]
      },
      "unknown_extensions": [
        {
          "oid": "2.5.29.18",
          "critical": false,
          "value_hex": "301582136f7574736964652e6578616d706c652e6e6574"
        }
      ]
    }
  ]
}
