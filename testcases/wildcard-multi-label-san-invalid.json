{
  "name": "wildcard-multi-label-san-invalid",
  "expected": "invalid",
  "description": "A DNS SAN with multiple wildcard labels (*.*.example.com) is not a valid DNS-ID per RFC 6125 and should fail SAN decoding or name-constraint matching.",
  "references": [
    "RFC 5280 4.2.1.6",
    "RFC 6125"
  ],
  "certs": [
    {
      "id": "root",
      "ca": true,
      "self_signed": true,
      "subject": "C=US,O=NC Tests,CN=NC Test Root"
    },
    {
      "id": "dns-ca",
      "ca": true,
      "issuer": "root",
      "subject": "C=US,O=NC Tests,CN=Multi-Wildcard CA",
      "name_constraints": {
        "permitted": {
          "dns": [
            "example.com"
          ]
        }
      }
    },
    {
      "id": "leaf",
      "issuer": "dns-ca",
      "subject": "C=US,O=NC Tests,CN=Multi-Wildcard Leaf",
      "san": {
        "dns": [
          "*.*.example.com"
        ]
      }
    }
  ]
}
