{
  "name": "dns-double-dot-san-invalid",
  "expected": "invalid",
  "description": "A malformed DNS SAN with an interior empty label should be rejected during constrained-name processing.",
  "references": [
    "RFC 5280 4.2.1.6",
    "https://github.com/golang/go/issues/23995"
  ],
  "certs": [
    {
      "id": "root",
      "ca": true,
      "self_signed": true,
      "subject": "C=US,O=NC Tests,CN=NC Test Root"
    },
    {
      "id": "dns-ca",
      "ca": true,
      "issuer": "root",
      "subject": "C=US,O=NC Tests,CN=DNS Syntax CA",
      "name_constraints": {
        "permitted": {
          "dns": [
            "example.com"
          ]
        }
      }
    },
    {
      "id": "leaf",
      "issuer": "dns-ca",
      "subject": "C=US,O=NC Tests,CN=Double Dot Leaf",
      "san": {
        "dns": [
          "www..example.com"
        ]
      }
    }
  ]
}
