{
  "name": "multi-ca-excluded-at-leaf-issuer-invalid",
  "expected": "invalid",
  "description": "An excluded subtree introduced only at the issuing intermediate (not the root) still applies to the leaf. Leaf SAN in the excluded subtree must be rejected.",
  "references": [
    "RFC 5280 6.1.4(h)",
    "RFC 5280 4.2.1.10"
  ],
  "certs": [
    {
      "id": "root",
      "ca": true,
      "self_signed": true,
      "subject": "C=US,O=NC Tests,CN=NC Test Root"
    },
    {
      "id": "int-ca",
      "ca": true,
      "issuer": "root",
      "subject": "C=US,O=NC Tests,CN=Pass-Through Int CA"
    },
    {
      "id": "exclude-ca",
      "ca": true,
      "issuer": "int-ca",
      "subject": "C=US,O=NC Tests,CN=Excluding Issuer CA",
      "name_constraints": {
        "excluded": {
          "dns": [
            ".evil.example.com"
          ]
        }
      }
    },
    {
      "id": "leaf",
      "issuer": "exclude-ca",
      "subject": "",
      "san": {
        "dns": [
          "host.evil.example.com"
        ]
      }
    }
  ]
}
