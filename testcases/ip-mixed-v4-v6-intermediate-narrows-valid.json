{
  "name": "ip-mixed-v4-v6-intermediate-narrows-valid",
  "expected": "valid",
  "description": "Root permits a broad IPv4 and IPv6 subtree; the intermediate narrows the permitted ranges. A leaf whose SANs fall inside both narrowed permits is valid.",
  "references": [
    "RFC 5280 4.2.1.10",
    "RFC 5280 6.1.4(g)",
    "Botan name_constraint_ipv6/mixed_multi"
  ],
  "certs": [
    {
      "id": "root",
      "ca": true,
      "self_signed": true,
      "subject": "C=US,O=NC Tests,CN=NC Test Root"
    },
    {
      "id": "ip-root-ca",
      "ca": true,
      "issuer": "root",
      "subject": "C=US,O=NC Tests,CN=Mixed IP Root-Issued CA",
      "name_constraints": {
        "permitted": {
          "ip": ["10.0.0.0/8", "2001:db8::/32"]
        }
      }
    },
    {
      "id": "ip-int-ca",
      "ca": true,
      "issuer": "ip-root-ca",
      "subject": "C=US,O=NC Tests,CN=Mixed IP Intermediate CA",
      "name_constraints": {
        "permitted": {
          "ip": ["10.1.0.0/16", "2001:db8:cafe::/48"]
        },
        "excluded": {
          "ip": ["10.1.99.0/24", "2001:db8:cafe:bad::/64"]
        }
      }
    },
    {
      "id": "leaf",
      "issuer": "ip-int-ca",
      "subject": "",
      "san": {
        "ip": ["10.1.2.3", "2001:db8:cafe::1"]
      }
    }
  ]
}
