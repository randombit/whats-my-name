{
  "name": "dns-leading-empty-label-invalid",
  "expected": "invalid",
  "description": "A SAN dNSName with a leading empty label, such as .example.com, is malformed and must not satisfy example.com constraints.",
  "references": [
    "RFC 5280 4.2.1.6",
    "https://github.com/golang/go/issues/65085"
  ],
  "certs": [
    {
      "id": "root",
      "ca": true,
      "self_signed": true,
      "subject": "C=US,O=NC Tests,CN=NC Test Root"
    },
    {
      "id": "dns-ca",
      "ca": true,
      "issuer": "root",
      "subject": "C=US,O=NC Tests,CN=DNS Syntax CA",
      "name_constraints": {
        "permitted": {
          "dns": [
            "example.com"
          ]
        }
      }
    },
    {
      "id": "leaf",
      "issuer": "dns-ca",
      "subject": "C=US,O=NC Tests,CN=Leading Empty Label Leaf",
      "san": {
        "dns": [
          ".example.com"
        ]
      }
    }
  ]
}
