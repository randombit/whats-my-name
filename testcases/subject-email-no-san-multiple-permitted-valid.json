{
  "name": "subject-email-no-san-multiple-permitted-valid",
  "expected": "valid",
  "description": "When there is no SAN, every emailAddress attribute in the subject DN must satisfy the rfc822 permits. Two emailAddress attributes both inside the permitted subtree validate.",
  "references": [
    "RFC 5280 4.2.1.10",
    "RFC 5280 7.5"
  ],
  "certs": [
    {
      "id": "root",
      "ca": true,
      "self_signed": true,
      "subject": "C=US,O=NC Tests,CN=NC Test Root"
    },
    {
      "id": "mail-ca",
      "ca": true,
      "issuer": "root",
      "subject": "C=US,O=NC Tests,CN=Multi-Email DN Permit CA",
      "name_constraints": {
        "permitted": {
          "email": [
            "example.com"
          ]
        }
      }
    },
    {
      "id": "leaf",
      "issuer": "mail-ca",
      "subject": "C=US,O=NC Tests,CN=Multi-Email DN Leaf,email=alice@example.com,email=bob@example.com"
    }
  ]
}
