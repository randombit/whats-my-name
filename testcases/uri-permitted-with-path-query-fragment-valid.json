{
  "name": "uri-permitted-with-path-query-fragment-valid",
  "expected": "valid",
  "description": "A bare-host URI permit (host.example.com) must accept a SAN that includes path, query, and fragment components - those are stripped before host comparison.",
  "references": [
    "RFC 5280 4.2.1.10",
    "RFC 5280 7.4"
  ],
  "certs": [
    {
      "id": "root",
      "ca": true,
      "self_signed": true,
      "subject": "C=US,O=NC Tests,CN=NC Test Root"
    },
    {
      "id": "uri-ca",
      "ca": true,
      "issuer": "root",
      "subject": "C=US,O=NC Tests,CN=URI Path Query CA",
      "name_constraints": {
        "permitted": {
          "uri": [
            "host.example.com"
          ]
        }
      }
    },
    {
      "id": "leaf",
      "issuer": "uri-ca",
      "subject": "",
      "san": {
        "uri": [
          "https://host.example.com/a?b=1#c"
        ]
      }
    }
  ]
}
