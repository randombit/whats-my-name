{
  "name": "srvname-excluded-service-invalid",
  "expected": "invalid-rfc4985",
  "description": "RFC 4985 §4 + RFC 5280 §4.2.1.10: an excludedSubtrees SRVName constraint with a service-only form (_mail) excludes ANY SRVName whose service name matches, regardless of the DNS part. A SAN of _mail.example.com is therefore excluded.",
  "references": [
    "RFC 4985 4",
    "RFC 5280 4.2.1.10"
  ],
  "certs": [
    {
      "id": "root",
      "ca": true,
      "self_signed": true,
      "subject": "C=US,O=NC Tests,CN=NC Test Root"
    },
    {
      "id": "srv-ca",
      "ca": true,
      "issuer": "root",
      "subject": "C=US,O=NC Tests,CN=SRVName Excluded CA",
      "name_constraints": {
        "critical": true,
        "excluded": {
          "other_name": [
            {"oid": "1.3.6.1.5.5.7.8.7", "ia5": "_mail"}
          ]
        }
      }
    },
    {
      "id": "leaf",
      "issuer": "srv-ca",
      "subject": "C=US,O=NC Tests,CN=SRVName Excluded Leaf",
      "san": {
        "other_name": [
          {"oid": "1.3.6.1.5.5.7.8.7", "ia5": "_mail.example.com"}
        ]
      }
    }
  ]
}
