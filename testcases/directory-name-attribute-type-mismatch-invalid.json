  "description": "permittedSubtrees directoryName has the same RDN values as the leaf subject but a different attribute OID at the matching position. The constraint should not match and the leaf must be rejected.",
  "references": [
    "RFC 5280 4.2.1.10",
    "RFC 5280 7.1"
  ],
  "certs": [
    {
      "id": "root",
      "ca": true,
      "self_signed": true,
      "subject": "C=US,O=NC Tests,CN=NC Test Root"
