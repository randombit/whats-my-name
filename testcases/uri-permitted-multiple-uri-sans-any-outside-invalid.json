{
  "name": "uri-permitted-multiple-uri-sans-any-outside-invalid",
  "expected": "invalid",
  "description": "Every URI SAN must satisfy active URI permits. One SAN inside the subtree plus one outside must reject the chain.",
  "references": [
    "RFC 5280 6.1.3(b)",
    "RFC 5280 4.2.1.10",
    "RFC 5280 7.4"
  ],
  "certs": [
    {
      "id": "root",
      "ca": true,
      "self_signed": true,
      "subject": "C=US,O=NC Tests,CN=NC Test Root"
    },
    {
      "id": "uri-ca",
      "ca": true,
      "issuer": "root",
      "subject": "C=US,O=NC Tests,CN=URI Multi-SAN Permit CA",
      "name_constraints": {
        "permitted": {
          "uri": [
            ".example.com"
          ]
        }
      }
    },
    {
      "id": "leaf",
      "issuer": "uri-ca",
      "subject": "",
      "san": {
        "uri": [
          "https://a.example.com/",
          "https://b.evil.com/"
        ]
      }
    }
  ]
}
