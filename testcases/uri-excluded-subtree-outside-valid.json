{
  "name": "uri-excluded-subtree-outside-valid",
  "expected": "valid",
  "description": "An excluded URI subtree (.example.com) does not affect a URI SAN whose host falls outside the subtree.",
  "references": [
    "RFC 5280 4.2.1.10",
    "RFC 5280 7.4"
  ],
  "certs": [
    {
      "id": "root",
      "ca": true,
      "self_signed": true,
      "subject": "C=US,O=NC Tests,CN=NC Test Root"
    },
    {
      "id": "uri-ca",
      "ca": true,
      "issuer": "root",
      "subject": "C=US,O=NC Tests,CN=URI Excl Outside CA",
      "name_constraints": {
        "excluded": {
          "uri": [
            ".example.com"
          ]
        }
      }
    },
    {
      "id": "leaf",
      "issuer": "uri-ca",
      "subject": "",
      "san": {
        "uri": [
          "https://evil.com/x"
        ]
      }
    }
  ]
}
