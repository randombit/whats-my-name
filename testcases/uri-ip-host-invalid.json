{
  "name": "uri-ip-host-invalid",
  "expected": "invalid",
  "description": "If URI constraints apply, a URI SAN whose host is an IP address must be rejected.",
  "references": [
    "RFC 5280 4.2.1.10"
  ],
  "certs": [
    {
      "id": "root",
      "ca": true,
      "self_signed": true,
      "subject": "C=US,O=NC Tests,CN=NC Test Root"
    },
    {
      "id": "uri-ca",
      "ca": true,
      "issuer": "root",
      "subject": "C=US,O=NC Tests,CN=URI Constrained CA",
      "name_constraints": {
        "permitted": {
          "uri": [
            "example.com"
          ]
        }
      }
    },
    {
      "id": "leaf",
      "issuer": "uri-ca",
      "subject": "",
      "san": {
        "uri": [
          "https://192.0.2.1/path"
        ]
      }
    }
  ]
}
