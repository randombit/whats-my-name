{
  "name": "uri-excluded-host-exact-subdomain-valid",
  "expected": "valid",
  "description": "A bare-host excluded URI constraint (host.example.com) is exact-match only and must not reject SANs at unrelated hosts, even at the same parent domain.",
  "references": [
    "RFC 5280 4.2.1.10",
    "RFC 5280 7.4"
  ],
  "certs": [
    {
      "id": "root",
      "ca": true,
      "self_signed": true,
      "subject": "C=US,O=NC Tests,CN=NC Test Root"
    },
    {
      "id": "uri-ca",
      "ca": true,
      "issuer": "root",
      "subject": "C=US,O=NC Tests,CN=URI Excl Bare-Host CA",
      "name_constraints": {
        "excluded": {
          "uri": [
            "host.example.com"
          ]
        }
      }
    },
    {
      "id": "leaf",
      "issuer": "uri-ca",
      "subject": "",
      "san": {
        "uri": [
          "https://evil.example.com/"
        ]
      }
    }
  ]
}
