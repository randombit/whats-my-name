{
  "name": "unsupported-critical-constraint-name-form-absent-valid",
  "expected": "valid-rfc5280",
  "description": "A critical unsupported registeredID constraint need only be processed or rejected when that name form appears in a subsequent certificate; a DNS-only leaf has no registeredID instance.",
  "references": [
    "RFC 5280 4.2.1.10"
  ],
  "certs": [
    {
      "id": "root",
      "ca": true,
      "self_signed": true,
      "subject": "C=US,O=NC Tests,CN=NC Test Root"
    },
    {
      "id": "rid-ca",
      "ca": true,
      "issuer": "root",
      "subject": "C=US,O=NC Tests,CN=Registered ID Constraint CA",
      "name_constraints": {
        "critical": true,
        "permitted": {
          "registered_id": ["1.2.3.4.5"]
        }
      }
    },
    {
      "id": "leaf",
      "issuer": "rid-ca",
      "subject": "",
      "san": {
        "dns": ["www.example.com"]
      }
    }
  ]
}
