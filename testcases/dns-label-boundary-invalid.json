{
  "name": "dns-label-boundary-invalid",
  "expected": "invalid",
  "description": "A DNS constraint is label based; badexample.com is not below example.com.",
  "references": [
    "RFC 5280 4.2.1.10",
    "RFC 5280 7.2"
  ],
  "certs": [
    {
      "id": "root",
      "ca": true,
      "self_signed": true,
      "subject": "C=US,O=NC Tests,CN=NC Test Root"
    },
    {
      "id": "dns-ca",
      "ca": true,
      "issuer": "root",
      "subject": "C=US,O=NC Tests,CN=DNS Constrained CA",
      "name_constraints": {
        "permitted": {
          "dns": [
            "example.com"
          ]
        }
      }
    },
    {
      "id": "leaf",
      "issuer": "dns-ca",
      "subject": "",
      "san": {
        "dns": [
          "badexample.com"
        ]
      }
    }
  ]
}
