{
  "name": "dns-excluded-overrides-permitted",
  "expected": "invalid",
  "description": "Excluded subtrees override permitted subtrees.",
  "references": [
    "RFC 5280 4.2.1.10"
  ],
  "certs": [
    {
      "id": "root",
      "ca": true,
      "self_signed": true,
      "subject": "C=US,O=NC Tests,CN=NC Test Root"
    },
    {
      "id": "dns-ca",
      "ca": true,
      "issuer": "root",
      "subject": "C=US,O=NC Tests,CN=DNS Constrained CA",
      "name_constraints": {
        "permitted": {
          "dns": [
            "example.com"
          ]
        },
        "excluded": {
          "dns": [
            "private.example.com"
          ]
        }
      }
    },
    {
      "id": "leaf",
      "issuer": "dns-ca",
      "subject": "",
      "san": {
        "dns": [
          "service.private.example.com"
        ]
      }
    }
  ]
}
