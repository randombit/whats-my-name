{
  "name": "uri-excluded-no-authority-invalid",
  "expected": "invalid",
  "description": "When a URI excluded constraint applies, a URI SAN without an authority host cannot be evaluated against the host-based constraint and must be rejected.",
  "references": [
    "RFC 5280 4.2.1.10",
    "Botan name_constraint_uri/excluded_no_authority"
  ],
  "certs": [
    {
      "id": "root",
      "ca": true,
      "self_signed": true,
      "subject": "C=US,O=NC Tests,CN=NC Test Root"
    },
    {
      "id": "uri-ca",
      "ca": true,
      "issuer": "root",
      "subject": "C=US,O=NC Tests,CN=URI Excluded No-Authority CA",
      "name_constraints": {
        "excluded": {
          "uri": [".example.com"]
        }
      }
    },
    {
      "id": "leaf",
      "issuer": "uri-ca",
      "subject": "",
      "san": {
        "uri": ["urn:example:leaf"]
      }
    }
  ]
}
