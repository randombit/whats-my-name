{
  "name": "self-constraint-not-applied-to-issuing-ca-valid",
  "expected": "valid-rfc5280",
  "description": "A certificate's own nameConstraints extension constrains subsequent certificates, not names in that same certificate.",
  "references": [
    "RFC 5280 4.2.1.10",
    "RFC 5280 6.1.4(g)",
    "https://github.com/golang/go/issues/59171"
  ],
  "certs": [
    {
      "id": "root",
      "ca": true,
      "self_signed": true,
      "subject": "C=US,O=NC Tests,CN=NC Test Root"
    },
    {
      "id": "dns-ca",
      "ca": true,
      "issuer": "root",
      "subject": "C=US,O=NC Tests,CN=Self Constraint CA",
      "san": {
        "dns": [
          "ca.example.net"
        ]
      },
      "name_constraints": {
        "permitted": {
          "dns": [
            "example.com"
          ]
        }
      }
    },
    {
      "id": "leaf",
      "issuer": "dns-ca",
      "subject": "",
      "san": {
        "dns": [
          "www.example.com"
        ]
      }
    }
  ]
}
