{
  "name": "uri-ipv6-zone-host-invalid",
  "expected": "invalid",
  "description": "If URI constraints apply, a URI SAN with an IPv6 literal and zone identifier is still an IP host and must be rejected rather than treated as a DNS host.",
  "references": [
    "RFC 5280 4.2.1.10",
    "Go CVE-2024-45341"
  ],
  "certs": [
    {
      "id": "root",
      "ca": true,
      "self_signed": true,
      "subject": "C=US,O=NC Tests,CN=NC Test Root"
    },
    {
      "id": "uri-ca",
      "ca": true,
      "issuer": "root",
      "subject": "C=US,O=NC Tests,CN=URI IPv6 Zone CA",
      "name_constraints": {
        "permitted": {
          "uri": [
            "example.com"
          ]
        }
      }
    },
    {
      "id": "leaf",
      "issuer": "uri-ca",
      "subject": "",
      "san": {
        "uri": [
          "https://[fe80::1%25eth0]/path"
        ]
      }
    }
  ]
}
