    {
      "id": "mail-ca",
      "ca": true,
      "issuer": "root",
      "subject": "C=US,O=NC Tests,CN=Full Mailbox CA",
      "name_constraints": {
        "permitted": {
          "email": ["alice@example.com"]
        }
      }
    },
    {
      "id": "leaf",
      "issuer": "mail-ca",
      "subject": "",
      "san": {
        "email": ["alice@example.com"]
      }
    }
  ]
