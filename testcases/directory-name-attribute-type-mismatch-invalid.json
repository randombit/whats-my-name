    {
      "id": "dir-ca",
      "ca": true,
      "issuer": "root",
      "subject": "C=US,O=NC Tests,CN=DN Attribute Mismatch CA",
      "name_constraints": {
        "permitted": {
          "directory_name": [
            "C=US,O=Example Corp"
          ]
        }
      }
    },
    {
      "id": "leaf",
      "issuer": "dir-ca",
      "subject": "C=US,OU=Example Corp,CN=Alice"
    }
  ]
