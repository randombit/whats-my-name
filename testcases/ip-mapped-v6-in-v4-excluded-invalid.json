{
  "name": "ip-mapped-v6-in-v4-excluded-invalid",
  "expected": "invalid",
  "description": "An IPv4 excluded subtree (10.0.0.0/8) should reject a leaf whose SAN is an IPv4-mapped IPv6 address inside that range (::ffff:10.0.0.5). Botan implements this by checking IPv6Address::as_ipv4() at constraint time.",
  "references": [
    "RFC 5280 4.2.1.10"
  ],
  "certs": [
    {
      "id": "root",
      "ca": true,
      "self_signed": true,
      "subject": "C=US,O=NC Tests,CN=NC Test Root"
    },
    {
      "id": "ip-ca",
      "ca": true,
      "issuer": "root",
      "subject": "C=US,O=NC Tests,CN=v4-Excl Mapped-v6 SAN CA",
      "name_constraints": {
        "excluded": {
          "ip": [
            "10.0.0.0/8"
          ]
        }
      }
    },
    {
      "id": "leaf",
      "issuer": "ip-ca",
      "subject": "",
      "san": {
        "ip": [
          "::ffff:10.0.0.5"
        ]
      }
    }
  ]
