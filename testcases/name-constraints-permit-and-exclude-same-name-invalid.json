{
  "name": "name-constraints-permit-and-exclude-same-name-invalid",
  "expected": "invalid",
  "description": "When the same GeneralSubtree appears in both permittedSubtrees and excludedSubtrees, exclusion wins per RFC 5280: any leaf inside that subtree must be rejected.",
  "references": [
    "RFC 5280 4.2.1.10"
  ],
  "certs": [
    {
      "id": "root",
      "ca": true,
      "self_signed": true,
      "subject": "C=US,O=NC Tests,CN=NC Test Root"
    },
    {
      "id": "dns-ca",
      "ca": true,
      "issuer": "root",
      "subject": "C=US,O=NC Tests,CN=Permit-And-Exclude CA",
      "name_constraints": {
        "permitted": {
          "dns": [
            "example.com"
          ]
        },
        "excluded": {
          "dns": [
            "example.com"
          ]
        }
      }
    },
    {
      "id": "leaf",
      "issuer": "dns-ca",
      "subject": "",
      "san": {
        "dns": [
          "www.example.com"
        ]
      }
    }
  ]
}
