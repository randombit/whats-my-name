    {
      "id": "dns-ca",
      "ca": true,
      "issuer": "root",
      "subject": "C=US,O=NC Tests,CN=Wildcard Constraint CA",
      "unknown_extensions": [
        {
          "oid": "2.5.29.30",
          "critical": true,
          "value_ascii2der": "SEQUENCE { [0] { SEQUENCE { [2 PRIMITIVE] { \"*.example.com\" } } } }"
        }
      ]
    },
    {
      "id": "leaf",
      "issuer": "dns-ca",
      "subject": "",
      "san": {
        "dns": [
          "www.example.com"
        ]
      }
    }
  ]
