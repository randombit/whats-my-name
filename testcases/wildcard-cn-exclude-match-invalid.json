{
  "name": "wildcard-cn-exclude-match-invalid",
  "expected": "invalid",
  "description": "A leaf with no SAN whose wildcard CN can expand into an excluded DNS subtree must be rejected.",
  "references": [
    "RFC 5280 4.2.1.10",
    "RFC 6125",
    "Botan name_constraint_wildcard_cn/exclude_match"
  ],
  "notes": [
    "The CN wildcard *.victim.com expands into the excluded .victim.com subtree, so the chain must be rejected."
  ],
  "certs": [
    {
      "id": "root",
      "ca": true,
      "self_signed": true,
      "subject": "C=US,O=NC Tests,CN=NC Test Root"
    },
    {
      "id": "dns-ca",
      "ca": true,
      "issuer": "root",
      "subject": "C=US,O=NC Tests,CN=Wildcard CN Exclude CA",
      "name_constraints": {
        "excluded": {
          "dns": [".victim.com"]
        }
      }
    },
    {
      "id": "leaf",
      "issuer": "dns-ca",
      "subject": "C=US,O=NC Tests,CN=*.victim.com"
    }
  ]
}
