{
  "name": "ipv4-only-permit-ipv6-san-invalid",
  "expected": "invalid",
  "description": "If a CA permits only an IPv4 subtree, an IPv6 iPAddress SAN must be rejected because iPAddress is a single GeneralName form.",
  "references": [
    "RFC 5280 4.2.1.10",
    "Botan name_constraint_ipv6/cross_v4only"
  ],
  "certs": [
    {
      "id": "root",
      "ca": true,
      "self_signed": true,
      "subject": "C=US,O=NC Tests,CN=NC Test Root"
    },
    {
      "id": "ip-ca",
      "ca": true,
      "issuer": "root",
      "subject": "C=US,O=NC Tests,CN=IPv4-Only Permit CA",
      "name_constraints": {
        "permitted": {
          "ip": ["10.0.0.0/8"]
        }
      }
    },
    {
      "id": "leaf",
      "issuer": "ip-ca",
      "subject": "",
      "san": {
        "ip": ["2001:db8::1"]
      }
    }
  ]
}
