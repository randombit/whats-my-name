{
  "name": "email-multiple-at-raw-san-invalid",
  "expected": "invalid",
  "description": "A raw rfc822Name SAN with multiple unescaped @ characters is malformed and should not be parsed ambiguously.",
  "references": [
    "RFC 5280 4.2.1.6",
    "https://github.com/golang/go/commit/62caa6db3d1f"
  ],
  "certs": [
    {
      "id": "root",
      "ca": true,
      "self_signed": true,
      "subject": "C=US,O=NC Tests,CN=NC Test Root"
    },
    {
      "id": "mail-ca",
      "ca": true,
      "issuer": "root",
      "subject": "C=US,O=NC Tests,CN=Raw Mail CA",
      "name_constraints": {
        "permitted": {
          "email": [
            "example.net"
          ]
        }
      }
    },
    {
      "id": "leaf",
      "issuer": "mail-ca",
      "subject": "C=US,O=NC Tests,CN=Multiple At Leaf",
      "unknown_extensions": [
        {
          "oid": "2.5.29.17",
          "critical": false,
          "value_ascii2der": "SEQUENCE { [1 PRIMITIVE] { \"admin@example.com@example.net\" } }"
        }
      ]
    }
  ]
}
