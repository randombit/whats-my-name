{
  "name": "wildcard-permitted-outside-subtree-invalid",
  "expected": "invalid-go-dnsname",
  "description": "permittedSubtrees .example.com plus a wildcard SAN *.evil.com: the wildcard cannot expand into example.com, so the chain must be rejected.",
  "references": [
    "RFC 5280 4.2.1.10",
    "RFC 6125"
  ],
  "notes": [
    "RFC 5280 does not define wildcard SAN semantics."
  ],
  "certs": [
    {
      "id": "root",
      "ca": true,
      "self_signed": true,
      "subject": "C=US,O=NC Tests,CN=NC Test Root"
    },
    {
      "id": "dns-ca",
      "ca": true,
      "issuer": "root",
      "subject": "C=US,O=NC Tests,CN=Wildcard Outside CA",
      "name_constraints": {
        "permitted": {
          "dns": [
            ".example.com"
          ]
        }
      }
    },
    {
      "id": "leaf",
      "issuer": "dns-ca",
      "subject": "C=US,O=NC Tests,CN=Wildcard Outside Leaf",
      "san": {
        "dns": [
          "*.evil.com"
        ]
      }
    }
  ]
}
