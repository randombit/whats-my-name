{
  "name": "directory-name-subtree-valid",
  "expected": "valid",
  "description": "A subject DN below a constrained directoryName subtree is valid.",
  "references": [
    "RFC 5280 4.2.1.10",
    "RFC 5280 7.1"
  ],
  "certs": [
    {
      "id": "root",
