{
  "name": "uri-host-single-label-invalid",
  "expected": "invalid-rfc5280-profile",
  "description": "A URI SAN with an authority component MUST include a fully qualified domain name or IP address as host; a single-label host is not a fully qualified domain name.",
  "references": [
    "RFC 5280 4.2.1.6",
    "RFC 5280 4.2.1.10"
  ],
  "certs": [
    {
      "id": "root",
      "ca": true,
      "self_signed": true,
      "subject": "C=US,O=NC Tests,CN=NC Test Root"
    },
    {
      "id": "uri-ca",
      "ca": true,
      "issuer": "root",
      "subject": "C=US,O=NC Tests,CN=Single Label URI CA",
      "name_constraints": {
        "permitted": {
          "uri": ["example.com"]
        }
      }
    },
    {
      "id": "leaf",
      "issuer": "uri-ca",
      "subject": "C=US,O=NC Tests,CN=Single Label URI Leaf",
      "san": {
        "uri": ["https://localhost/path"]
      }
    }
  ]
}
