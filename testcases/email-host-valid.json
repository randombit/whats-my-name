{
  "name": "email-host-valid",
  "expected": "valid",
  "description": "An rfc822Name constraint without a leading dot matches a mailbox at that host.",
  "references": [
    "RFC 5280 4.2.1.10",
    "RFC 5280 7.5"
  ],
  "certs": [
    {
      "id": "root",
      "ca": true,
      "self_signed": true,
      "subject": "C=US,O=NC Tests,CN=NC Test Root"
    },
    {
      "id": "mail-ca",
      "ca": true,
      "issuer": "root",
      "subject": "C=US,O=NC Tests,CN=Mail Constrained CA",
      "name_constraints": {
        "permitted": {
          "email": [
            "example.com"
          ]
        }
      }
    },
    {
      "id": "leaf",
      "issuer": "mail-ca",
      "subject": "",
      "san": {
        "email": [
          "alice@example.com"
        ]
      }
    }
  ]
}
