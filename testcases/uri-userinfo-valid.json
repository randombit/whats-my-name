{
  "name": "uri-userinfo-valid",
  "expected": "valid",
  "description": "URI name-constraint processing must ignore the userinfo component and compare the authority host.",
  "references": [
    "RFC 5280 4.2.1.10",
    "https://github.com/openssl/openssl/commit/e599893a9f"
  ],
  "certs": [
    {
      "id": "root",
      "ca": true,
      "self_signed": true,
      "subject": "C=US,O=NC Tests,CN=NC Test Root"
    },
    {
      "id": "uri-ca",
      "ca": true,
      "issuer": "root",
      "subject": "C=US,O=NC Tests,CN=URI Userinfo CA",
      "name_constraints": {
        "permitted": {
          "uri": [
            "example.com"
          ]
        }
      }
    },
    {
      "id": "leaf",
      "issuer": "uri-ca",
      "subject": "",
      "san": {
        "uri": [
          "https://user:pass@example.com/path"
        ]
      }
    }
  ]
}
