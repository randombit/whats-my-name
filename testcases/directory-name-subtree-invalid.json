{
  "name": "directory-name-subtree-invalid",
  "expected": "invalid",
  "description": "A non-empty subject DN outside a permitted directoryName subtree must be rejected.",
  "references": [
    "RFC 5280 4.2.1.10",
    "RFC 5280 7.1"
  ],
  "certs": [
    {
      "id": "root",
      "ca": true,
      "self_signed": true,
      "subject": "C=US,O=NC Tests,CN=NC Test Root"
    },
    {
      "id": "dir-ca",
      "ca": true,
      "issuer": "root",
      "subject": "C=US,O=NC Tests,CN=Directory Constraint CA",
      "name_constraints": {
        "permitted": {
          "directory_name": ["C=US,O=Example Corp"]
        }
      }
    },
    {
      "id": "leaf",
      "issuer": "dir-ca",
      "subject": "C=US,O=Other Corp,CN=Alice"
    }
  ]
}
