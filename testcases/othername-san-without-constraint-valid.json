{
  "name": "othername-san-without-constraint-valid",
  "expected": "valid",
  "description": "A leaf has an otherName (SmtpUTF8Mailbox) SAN but the active NC restricts only DNS. The otherName SAN form should not be evaluated because no constraint targets it.",
  "references": [
    "RFC 5280 4.2.1.10"
  ],
  "certs": [
    {
      "id": "root",
      "ca": true,
      "self_signed": true,
      "subject": "C=US,O=NC Tests,CN=NC Test Root"
    },
    {
      "id": "dns-ca",
      "ca": true,
      "issuer": "root",
      "subject": "C=US,O=NC Tests,CN=DNS-Only With OtherName SAN CA",
      "name_constraints": {
        "permitted": {
          "dns": [
            "example.com"
          ]
        }
      }
    },
    {
      "id": "leaf",
      "issuer": "dns-ca",
      "subject": "",
      "san": {
        "dns": [
          "www.example.com"
        ],
        "other_name": [
          {
            "oid": "1.3.6.1.5.5.7.8.9",
            "utf8": "alice@unrelated.com"
          }
        ]
      }
    }
  ]
}
